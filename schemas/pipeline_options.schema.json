{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jae7cho/fmri-defaults-kb/schemas/pipeline_options.schema.json",
  "title": "Every user-settable option of a pipeline at each listed version",
  "description": "2026-11-11. Generated by scripts/extract_pipeline_options.py from the pipeline's command-line parser or default configuration at each listed tag, compressed into version ranges; step_parameters (values the code fixes) are curated.",
  "type": "object",
  "properties": {
    "pipeline_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "default",
              "example"
            ],
            "description": "default: the file the code loads as its default; example: a shipped example no code loads (its values may not be the defaults)."
          }
        },
        "required": [
          "version",
          "tag",
          "file",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "available": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "from_version": {
                    "type": "string"
                  },
                  "to_version": {
                    "type": "string"
                  }
                },
                "required": [
                  "from_version",
                  "to_version"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "versions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "versions"
                ],
                "additionalProperties": false
              }
            ]
          },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "from_version": {
                  "type": "string"
                },
                "to_version": {
                  "type": "string"
                },
                "default": {},
                "choices": {},
                "action": {
                  "type": "string"
                },
                "nargs": {},
                "source": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "from_version",
                "to_version",
                "source"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "available",
          "ranges"
        ],
        "additionalProperties": false
      }
    },
    "step_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "from_version": {
                  "type": "string"
                },
                "to_version": {
                  "type": "string"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "override_flag": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "config_key": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "from_version",
                "to_version",
                "value",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "parameter",
          "ranges"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "pipeline_id",
    "generated_by",
    "method",
    "repository",
    "sources",
    "options"
  ],
  "additionalProperties": false
}
