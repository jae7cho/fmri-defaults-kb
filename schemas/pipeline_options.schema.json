{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jae7cho/fmri-defaults-kb/schemas/pipeline_options.schema.json",
  "title": "Every user-settable option of a pipeline at each listed version",
  "description": "2026-11-11. Generated by scripts/extract_pipeline_options.py from the pipeline's command-line parser or default configuration at each listed tag, compressed into version ranges; step_parameters (values the code fixes) are curated.",
  "type": "object",
  "properties": {
    "pipeline_id": {
      "type": "string",
      "minLength": 1
    },
    "generated_by": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "options": {
            "type": "integer",
            "minimum": 0,
            "description": "Options in the version's parser or configuration file (GUI-only options not counted)."
          },
          "sha256": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "default",
              "example"
            ],
            "description": "default: the file the code loads as its default; example: a shipped example no code loads (its values may not be the defaults)."
          },
          "gui_rules": {
            "type": "object",
            "properties": {
              "choice_line": {
                "type": "integer"
              },
              "checklist_line": {
                "type": "integer"
              }
            },
            "additionalProperties": false,
            "description": "C-PAC: the lines of CPAC/GUI/interface/utils/generic_class.py at this tag where a choice box starts on its first value (choice_line) and a checklist starts all checked only for dtype LBOOL (checklist_line); the rules gui_default follows."
          }
        },
        "required": [
          "version",
          "tag",
          "file",
          "options"
        ],
        "additionalProperties": false
      }
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "group": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "help": {
            "type": "string"
          },
          "available": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "from_version": {
                    "type": "string"
                  },
                  "to_version": {
                    "type": "string"
                  }
                },
                "required": [
                  "from_version",
                  "to_version"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "versions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "versions"
                ],
                "additionalProperties": false
              }
            ]
          },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "from_version": {
                  "type": "string"
                },
                "to_version": {
                  "type": "string"
                },
                "default": {},
                "choices": {},
                "action": {
                  "type": "string"
                },
                "nargs": {},
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "description": "'line N at <version>' (and '; line M at <version>' for the range's last version): the line in that version's file, which sources[] records; a GUI-only option cites its GUI page."
                },
                "in_config": {
                  "type": "boolean",
                  "description": "false: the option is in the GUI pages, not in that version's configuration file."
                },
                "gui_default": {
                  "description": "The initial value the GUI gives the option (C-PAC's GUI pages)."
                },
                "gui_source": {
                  "type": "string",
                  "description": "The GUI page call that sets gui_default, as 'pages/<file>.py line N at <tag>', relative to CPAC/GUI/interface/; the constructor rule it follows is in sources[].gui_rules."
                }
              },
              "required": [
                "from_version",
                "to_version",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "nested_as": {
            "type": "string",
            "description": "C-PAC: the 1.8 nested path this 1.7 flat key maps to (C-PAC's own map)."
          },
          "flat_as": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "C-PAC: the 1.7 flat keys that map to this 1.8 path."
          },
          "deprecated_in_1_8": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "available",
          "ranges"
        ],
        "additionalProperties": false
      }
    },
    "step_parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1
          },
          "parameter": {
            "type": "string",
            "minLength": 1
          },
          "ranges": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "from_version": {
                  "type": "string"
                },
                "to_version": {
                  "type": "string"
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "override_flag": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "config_key": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "from_version",
                "to_version",
                "value",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "step",
          "parameter",
          "ranges"
        ],
        "additionalProperties": false
      }
    },
    "key_map_source": {
      "type": "string"
    },
    "timeline": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string"
          },
          "tag": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "listed": {
            "type": "boolean"
          }
        },
        "required": [
          "version",
          "tag",
          "date",
          "listed"
        ],
        "additionalProperties": false
      },
      "description": "Every final release tag with the date git records for it, and whether kb/pipelines lists it."
    },
    "step_options": {
      "type": "object",
      "description": "Curated: the options that answer each step, each with the releases (on the timeline) it is claimed for.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "from_version": {
              "type": "string"
            },
            "to_version": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "from_version",
            "to_version"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "pipeline_id",
    "generated_by",
    "method",
    "repository",
    "sources",
    "options"
  ],
  "additionalProperties": false
}
