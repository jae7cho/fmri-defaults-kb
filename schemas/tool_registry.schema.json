                  "type": "string",
                  "minLength": 1,
                  "description": "The job option the default fills (e.g. eoptions.rtm)."
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            },
            "mask": {
              "type": "object",
              "properties": {
                "option": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The job option the default fills (e.g. eoptions.rtm)."
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            },
            "cost_function": {
              "type": "object",
              "properties": {
                "option": {
                  "type": "string",
                  "minLength": 1,
                  "description": "The job option the default fills (e.g. eoptions.rtm)."
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "documented_for",
            "job"
          ],
          "additionalProperties": false
        },
        "verification": {
          "type": "string",
          "enum": [
            "script_at_tag",
            "manual",
            "paper",
            "unverified"
          ],
          "description": "How the program attribution is verified (2026-11-11): script_at_tag (the pipeline's or tool's code read at a named tag, commit or release), manual (its documentation, help text or user guide), paper (a publication only), unverified. Filled from the source text."
        },
        "flirt_defaults": {
          "type": "object",
          "description": "FSL flirt's own defaults (2026-11-11), for a pipeline that registers each volume with flirt (HCP Pipelines v3.x); each with its source line.",
          "properties": {
            "documented_for": {
              "type": "string",
              "minLength": 1
            },
            "version_tokens": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "job": {
              "type": "string",
              "minLength": 1
            },
            "reference_scan": {
              "type": "object",
              "properties": {
                "option": {
                  "type": "string",
                  "minLength": 1,
