{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jae7cho/fmri-defaults-kb/schemas/tool_registry.schema.json",
  "title": "fMRI software package (tool) registry entry",
  "description": "One YAML per software package under kb/tools/. A package ships programs. The optional realignment block names the one program the package supplies for between-volume realignment, with a citable source; the optional programs list names other programs the package ships, each with its source (2026-11-03: realignment optional, programs added, for FreeSurfer).",
  "type": "object",
  "properties": {
    "tool_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "Stable lower-case identifier; also the bare name token the fallback matches (e.g. 'spm' matches 'SPM12')."
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "description": "Spellings that name this package, matched whole after normalization; a trailing version token is stripped first for version_token packages."
    },
    "version_token": {
      "type": "boolean",
      "description": "True when the version is part of the name token as written (SPM8, SPM12); false when a digit run after the name is a citation artefact of the text layer."
    },
    "realignment": {
      "type": "object",
      "properties": {
        "program": {
          "type": "string",
          "minLength": 1,
          "description": "The realignment program this package supplies, as it is named in its documentation."
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Citation: the paper that documents the program, and/or the package's documentation."
        },
        "notes": {
          "type": "string"
        },
        "defaults": {
          "type": "object",
          "description": "The realignment program's own defaults (2026-11-09), each with the manual page, help-text option or source line it is read from. A default that cannot be sourced is omitted. Applies to the program run with its own defaults; a pipeline that wraps it may override them.",
          "properties": {
            "documented_for": {
              "type": "string",
              "minLength": 1,
              "description": "The version(s) of the package the defaults are read from."
            },
            "version_tokens": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Version tokens the defaults apply to (e.g. ['12'] for SPM12); empty or absent = not version-specific."
            },
            "reference_scan": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            },
            "interpolation_estimate": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            },
            "interpolation_reslice": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            },
            "cost_function": {
              "type": "object",
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "source": {
                  "type": "string",
                  "minLength": 1
                },
                "notes": {
                  "type": "string"
                }
              },
              "required": [
                "value",
                "source"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "documented_for"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "program",
        "source"
      ],
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    },
    "programs": {
      "type": "array",
      "description": "Programs the package ships that a paper may name (e.g. FreeSurfer's recon-all, aseg, mri_vol2surf), each with a citable source.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "purpose",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "tool_id",
    "display_name",
    "aliases",
    "version_token"
  ],
  "additionalProperties": false
}
