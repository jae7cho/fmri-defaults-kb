    "notes": {
      "type": "string"
    },
    "programs": {
      "type": "array",
      "description": "Programs the package ships that a paper may name (e.g. FreeSurfer's recon-all, aseg, mri_vol2surf), each with a citable source.",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "available_from": {
            "type": "string",
            "minLength": 1,
            "description": "2026-11-11: the earliest package version the program is documented in (a timeline entry)."
          },
          "available_from_source": {
            "type": "string",
            "minLength": 1,
            "description": "Where available_from is read, with what the source does and does not establish."
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Programs of the same package that do the same step another way (e.g. 2D against 3D registration)."
          },
          "notes": {
